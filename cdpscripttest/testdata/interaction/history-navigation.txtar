-- meta.yaml --
name: Reload Page
description: Reload an offline page and assert the deterministic load marker.
headless: true
timeout: 20s

-- main.cdp --
goto $FIXTURE_BASE_URL/interaction/pages/history-start.html
wait '#page-id'
assert text '#page-id' history-start
assert text '#load-count' 1
reload
wait '#reloaded-marker'
assert visible '#reloaded-marker'
assert text '#load-count' 2
assert text '#reloaded-marker' Reloaded 2 times
