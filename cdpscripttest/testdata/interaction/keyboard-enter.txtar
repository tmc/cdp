-- meta.yaml --
name: Keyboard Press
description: Press character keys into a focused input and assert the mirrored text.
headless: true
timeout: 20s

-- main.cdp --
goto $FIXTURE_BASE_URL/interaction/pages/keyboard-enter.html
wait '#command'
click '#command'
press H
press e
press l
press l
press o
wait '#result'
assert visible '#result'
assert text '#result' Typed: Hello
