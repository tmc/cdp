-- main.cdp --
source -as submit-form $FIXTURE_ROOT/testdata/interaction/source-helper.cdp
goto $FIXTURE_BASE_URL/interaction/pages/form-submit.html
wait '#signup-form'
submit-form Grace-Hopper grace@example.com
wait '#result'
assert visible '#result'
assert text '#result' Saved Grace-Hopper (grace@example.com)
