-- meta.yaml --
name: Form Submit
description: Fill a local form and assert the submitted result.
headless: true
timeout: 20s

-- main.cdp --
goto $FIXTURE_BASE_URL/interaction/pages/form-submit.html
wait '#signup-form'
fill '#name' Ada Lovelace
type '#email' ada@example.com
click '#submit'
wait '#result'
assert visible '#result'
assert text '#result' Saved Ada Lovelace (ada@example.com)
