# Purpose: smoke-test navigation and screenshots against example.com.
# Usage: cdp run examples/simple-test.txtar
# Inputs: network access to example.com.
# Verification: live-only; external site flow, not a CI fixture.

-- main.cdp --
# Navigate to example.com
goto https://example.com

# Wait for page
wait 2s

# Take screenshot
screenshot /tmp/simple-test.png

log "Test completed!"
