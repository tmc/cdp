# Purpose: exercise core cdpscript commands against example.com.
# Usage: cdpscript examples/engine-features.txtar
# Inputs: network access to example.com.
# Verification: live-only; external site flow, not a CI fixture.

-- main.cdp --
# Test blocking
block */ads/*
log Blocking ads patterns

goto https://example.com
wait 2s

# Test title command
title

# Test url command
url

# Test assert exists
assert exists h1

# Test assert text
assert text h1 Example

# Test assert visible
assert visible h1

screenshot example-features.png
log Done!
