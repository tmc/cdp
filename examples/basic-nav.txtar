# Purpose: demonstrate basic navigation, waiting, and screenshots against Google.
# Usage: cdp run examples/basic-nav.txtar
# Inputs: network access to www.google.com.
# Verification: live-only; external site flow, not a CI fixture.

-- main.cdp --
# Navigate to a simple page
goto https://www.google.com

# Wait for the page to load
wait 2s

# Take a screenshot
screenshot /tmp/google.png

log "Basic navigation test completed"
