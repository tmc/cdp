# Purpose: demonstrate a parameterized navigation and extraction flow.
# Usage: cdpscript examples/simple.txtar https://example.com
# Inputs: ARG1 is the URL to visit.
# Verification: live-only; external site flow, not a CI fixture.

-- main.cdp --
# Navigate to the site
goto ${ARG1}

# Wait for page to load
wait h1

# Extract the title
extract h1

# Take a screenshot
screenshot screenshot.png

# Log completion
log Script completed successfully
