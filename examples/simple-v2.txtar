# Purpose: minimal rsc.io/script-style navigation example.
# Usage: cdpscript examples/simple-v2.txtar
# Inputs: network access to example.com.
# Verification: live-only; external site flow, not a CI fixture.

-- main.cdp --
# Navigate to example.com
goto https://example.com

# Wait for page to load
wait 2s

# Take a screenshot
screenshot /tmp/simple-v2.png

log Test completed successfully!
